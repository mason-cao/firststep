# Railway injects this from the PostgreSQL service in production.
# For local development, use the database's public connection URL.
DATABASE_URL=

# Leave blank for Railway private networking. Set to "require" only when your
# external PostgreSQL connection requires TLS.
DATABASE_SSL=

# Comma-separated leadership emails that may sign in to the review desk.
LEADERSHIP_EMAILS=firststepteam2020@gmail.com

# Use different, randomly generated values in production.
LEADERSHIP_ACCESS_CODE=
AUTH_SECRET=
